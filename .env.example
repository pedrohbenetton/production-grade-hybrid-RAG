# Copy to .env (git-ignored). Every value is optional; defaults are shown.

# --- Generation (/v1/query). Without a key the endpoint answers 400. ---
# ANTHROPIC_API_KEY=
# RAG_LLM__MODEL=claude-sonnet-5-5

# --- Vector store: embedded on-disk (default) or a Qdrant server ---
# RAG_QDRANT__PATH=./data/qdrant
# RAG_QDRANT__URL=http://localhost:6333

# --- Reranking: flashrank | cohere | none ---
# RAG_RERANK__PROVIDER=flashrank
# RAG_RERANK__COHERE_API_KEY=

# --- Guardrails: annotate | filter | abstain ---
# RAG_GUARDRAILS__POLICY=filter
# RAG_GUARDRAILS__MIN_FAITHFULNESS=0.8
# RAG_GUARDRAILS__MIN_RELEVANCE=
# Use onnx/model.onnx on non-x86 CPUs (the int8 default needs AVX2).
# RAG_GUARDRAILS__NLI_ONNX_FILE=onnx/model_quint8_avx2.onnx

# --- Retrieval and chunking ---
# RAG_RETRIEVAL__FINAL_K=5
# RAG_CHUNKING__MAX_TOKENS=512
# RAG_EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
